rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hostOf(gameId) {
      return signedIn() && get(/databases/$(database)/documents/games/$(gameId)).data.host_id == request.auth.uid;
    }

    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /questions/{questionId} {
        // Questions are readable by signed-in clients for the current MVP.
        // For hardened production anti-cheat, move scoring to a callable Cloud Function.
        allow read: if signedIn();
        allow write: if signedIn() && get(/databases/$(database)/documents/quizzes/$(quizId)).data.ownerId == request.auth.uid;
      }
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host_id == request.auth.uid;
      allow update, delete: if hostOf(gameId);

      match /questions/{questionId} {
        allow read: if signedIn();
        allow write: if hostOf(gameId);
      }

      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == playerId;
        allow update: if signedIn() && request.auth.uid == playerId;
        allow delete: if hostOf(gameId) || (signedIn() && request.auth.uid == playerId);
      }

      match /answers/{answerId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.playerId == request.auth.uid;
        allow update, delete: if hostOf(gameId);
      }
    }
  }
}
